	partition Towns = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/towns.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"ucl_code", "town", "persons_2021", "service", "trips_week", "days_served", "to_greater_adelaide_week", "school_trips_week", "operators", "lat", "lng"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"ucl_code", type text}, {"town", type text}, {"persons_2021", Int64.Type}, {"service", type text}, {"trips_week", Int64.Type}, {"days_served", Int64.Type}, {"to_greater_adelaide_week", Int64.Type}, {"school_trips_week", Int64.Type}, {"operators", type text}, {"lat", type number}, {"lng", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
