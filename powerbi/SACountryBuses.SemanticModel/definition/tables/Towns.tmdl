table Towns
	lineageTag: 0edd523d-13dd-1097-2245-3df873485d21

	measure 'Towns counted' = COUNTROWS ( Towns )
		formatString: #,0
		lineageTag: c218a98f-1e3a-5011-0beb-82b0e08e71e4

	/// Residents in the 2021 Census
	measure Residents = SUM ( Towns[persons_2021] )
		formatString: #,0
		lineageTag: 6720dd17-a041-405d-63c6-13536d9206e8

	/// Scheduled bus trips leaving the towns, 23 to 29 November 2026, school services left out
	measure 'Trips in the week' = SUM ( Towns[trips_week] )
		formatString: #,0
		lineageTag: d71a15ae-e839-3d6a-a9fe-57dbf7b686a5

	/// No scheduled bus, or a bus on 1 to 4 days of the week
	measure 'Towns with a bus on 4 days or fewer' = CALCULATE ( COUNTROWS ( Towns ), Towns[days_served] <= 4 )
		formatString: #,0
		lineageTag: 5bcb7811-43fe-bfb8-efc3-7cfabea356b4

	measure 'Residents with a bus on 4 days or fewer' = CALCULATE ( SUM ( Towns[persons_2021] ), Towns[days_served] <= 4 )
		formatString: #,0
		lineageTag: f5cd3513-af88-65c3-ebec-0c609e4b1cc0

	measure 'Share of residents with a bus on 4 days or fewer' = DIVIDE ( [Residents with a bus on 4 days or fewer], [Residents] )
		formatString: 0.0%
		lineageTag: 66553b47-f687-5cc1-faae-a24a2cc68a96

	column ucl_code
