table Days
	lineageTag: e807d3cc-f8d2-4c8c-1a3d-86db5da78da8

	measure 'Trips that day' = SUM ( Days[trips] )
		formatString: #,0
		lineageTag: 97f8a298-d336-c4ef-3ab8-f15cf6b86273

	column day
		dataType: string
		lineageTag: d4a80be1-23ea-8898-2ada-4499522339cd
		summarizeBy: none
		sourceColumn: day

		annotation SummarizationSetBy = Automatic

	column date
		dataType: string
		lineageTag: 476e893d-26d1-2dcf-9765-04decae5abb1
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column trips
		dataType: int64
		formatString: #,0
		lineageTag: def6e523-0baa-fe9e-5d23-bd153a7e0fb5
		summarizeBy: none
		sourceColumn: trips

		annotation SummarizationSetBy = Automatic

	partition Days = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/days.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"day", "date", "trips"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"day", type text}, {"date", type text}, {"trips", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
